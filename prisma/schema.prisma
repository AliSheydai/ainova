// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

// =====================
// User
// =====================
model User {
  id               String   @id @default(cuid())
  phone            String?  @unique
  telegramId       String?  @unique
  telegramUsername String?
  name             String?
  role             Role     @default(USER)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orders          Order[]
  supportTickets  SupportTicket[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

// OTP Login tokens
model OtpToken {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([phone, used, expiresAt])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("otp_tokens")
}

// =====================
// Product & Plan
// =====================
enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum FulfillmentType {
  ACTIVATION_LINK
  PRE_CREATED_ACCOUNT
  CUSTOMER_PROVISIONING
  MANUAL
  ACTIVATION_CODE
  DOWNLOAD
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

enum InventoryType {
  ACTIVATION_LINK
  PRE_CREATED_ACCOUNT
  LICENSE_KEY
}

model Product {
  id               String          @id @default(cuid())
  title            String          @default("")
  slug             String          @unique
  shortDescription String?
  description      String?
  image            String?
  price            Int             @default(0) // price in Toman (Base / Starts-from)
  status           ProductStatus   @default(ACTIVE)
  stock            Int             @default(0)
  purchaseCount    Int             @default(0)
  sortOrder        Int             @default(0)
  archivedAt       DateTime?
  features         Json?           // Array of feature strings or structured feature objects
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  orders          Order[]
  activationLinks ActivationLink[]
  plans           Plan[]
  inventoryItems  InventoryItem[]
  coupons         Coupon[]

  @@map("products")
}

model Plan {
  id                String          @id @default(cuid())
  productId         String
  name              String
  duration          Int             // duration in months
  price             Int             // price in Toman (Rials / 10)
  active            Boolean         @default(true)
  fulfillmentType   FulfillmentType @default(ACTIVATION_LINK)
  checkoutFields    Json?           // Array of CheckoutFieldDefinition [{ key, label, type, required, placeholder, order }]
  fulfillmentConfig Json?           // Custom config for fulfillment
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  orders          Order[]
  activationLinks ActivationLink[]
  inventoryItems  InventoryItem[]

  @@index([productId])
  @@index([productId, active])
  @@map("plans")
}

// =====================
// Order
// =====================
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Coupon {
  id                String       @id @default(cuid())
  code              String       @unique
  description       String?
  discountType      DiscountType @default(PERCENTAGE)
  discountValue     Int          // percentage (e.g. 20 for 20%) or fixed Toman (e.g. 50000)
  minOrderAmount    Int?         // minimum order amount in Toman required to apply
  maxDiscountAmount Int?         // maximum discount amount in Toman for percentage coupons
  maxUses           Int?         // maximum total times coupon can be used across system
  usedCount         Int          @default(0)
  expiresAt         DateTime?    // expiration date
  active            Boolean      @default(true)
  productId         String?      // optional: limit to specific product
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  orders            Order[]
  product           Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([code])
  @@index([productId])
  @@map("coupons")
}

model Order {
  id                String            @id @default(cuid())
  userId            String
  productId         String?
  planId            String?
  couponId          String?
  amount            Int               // in Toman (final payable amount after discount)
  discountAmount    Int               @default(0) // total discount amount in Toman
  status            OrderStatus       @default(PENDING_PAYMENT)
  fulfillmentStatus FulfillmentStatus @default(PENDING)
  checkoutData      Json?             // Snapshot of customer answers at checkout
  source            String?           @default("web") // "web" | "telegram" | "bale" | "rubika" | "soroush"
  telegramChatId    String?

  // Refund metadata (Section 4.1)
  refundAmount      Int?              // Refunded amount in Toman
  refundReason      String?           // Reason for refund
  refundRefId       String?           // Bank / Sheba tracking reference ID
  refundedAt        DateTime?         // Timestamp of refund

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  product         Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  plan            Plan?           @relation(fields: [planId], references: [id], onDelete: SetNull)
  coupon          Coupon?         @relation(fields: [couponId], references: [id], onDelete: SetNull)
  payment         Payment?
  activationLink  ActivationLink?
  delivery        Delivery?
  inventoryItem   InventoryItem?
  supportTickets  SupportTicket[]

  @@index([userId])
  @@index([productId])
  @@index([planId])
  @@index([couponId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

// =====================
// Payment
// =====================
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String        @unique
  amount          Int
  status          PaymentStatus @default(PENDING)
  gatewayName     String        @default("zarinpal")
  authority       String?       @unique  // Zarinpal authority or Mock transaction ID
  refId           String?       // Zarinpal refId or Mock refId after success
  gatewayResponse Json?
  paidAt          DateTime?     // Exact timestamp when payment was verified
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([refId])
  @@index([gatewayName, status])
  @@map("payments")
}

// =====================
// Activation Links (@deprecated - Kept for backwards-compatibility; use InventoryItem)
// =====================
enum LinkStatus {
  AVAILABLE
  RESERVED
  USED
  INVALID
}

model ActivationLink {
  id          String     @id @default(cuid())
  productId   String?
  planId      String?
  url         String
  status      LinkStatus @default(AVAILABLE)
  orderId     String?    @unique
  createdAt   DateTime   @default(now())
  assignedAt  DateTime?
  usedAt      DateTime?

  product     Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  plan        Plan?      @relation(fields: [planId], references: [id], onDelete: SetNull)
  order       Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, planId, status])
  @@index([planId, status])
  @@index([status])
  @@map("activation_links")
}

// =====================
// Support Tickets
// =====================
enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id          String       @id @default(cuid())
  userId      String?
  orderId     String?
  subject     String
  message     String
  status      TicketStatus @default(OPEN)
  contactInfo String?      // phone / telegram / email
  response    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@map("support_tickets")
}

// =====================
// System Settings
// =====================
model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

// =====================
// Generic Deliveries
// =====================
model Delivery {
  id          String          @id @default(cuid())
  orderId     String          @unique
  type        FulfillmentType
  status      DeliveryStatus  @default(DELIVERED)
  data        Json            // { link?: string, email?: string, password?: string, manualNote?: string, ... }
  deliveredAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("deliveries")
}

// =====================
// Generic Inventory Items (Links, Accounts, etc.)
// =====================
model InventoryItem {
  id         String        @id @default(cuid())
  productId  String?
  planId     String?
  type       InventoryType
  status     LinkStatus    @default(AVAILABLE) // AVAILABLE, RESERVED, USED, INVALID
  data       Json          // { url?: string } or { email?: string, password?: string, note?: string }
  orderId    String?       @unique
  assignedAt DateTime?
  usedAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  product    Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  plan       Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  order      Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, planId, status])
  @@index([planId, status])
  @@index([productId, status])
  @@index([type, status])
  @@index([type, status, planId])
  @@index([type, status, productId])
  @@map("inventory_items")
}


