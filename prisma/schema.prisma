// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

// =====================
// User
// =====================
model User {
  id               String   @id @default(cuid())
  phone            String?  @unique
  telegramId       String?  @unique
  telegramUsername String?
  name             String?
  role             Role     @default(USER)
  tokenVersion     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orders          Order[]
  supportTickets  SupportTicket[]
  notifications   Notification[]
  notificationReads NotificationRead[]
  reviews         Review[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

// OTP Login tokens
model OtpToken {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([phone, used, expiresAt])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("otp_tokens")
}

// =====================
// Product & Plan
// =====================
enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum FulfillmentType {
  ACTIVATION_LINK
  PRE_CREATED_ACCOUNT
  CUSTOMER_PROVISIONING
  MANUAL
  ACTIVATION_CODE
  DOWNLOAD
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

enum InventoryType {
  ACTIVATION_LINK
  PRE_CREATED_ACCOUNT
  LICENSE_KEY
}

model Product {
  id               String          @id @default(cuid())
  title            String          @default("")
  slug             String          @unique
  shortDescription String?
  description      String?
  image            String?
  price            Int             @default(0) // price in Toman (Base / Starts-from)
  status           ProductStatus   @default(ACTIVE)
  stock            Int             @default(0)
  purchaseCount    Int             @default(0)
  sortOrder        Int             @default(0)
  archivedAt       DateTime?
  features         Json?           // Array of feature strings or structured feature objects
  videoUrl         String?         // Product introductory/demo video URL or embed
  isFeatured       Boolean         @default(false) // Whether product is starred for landing pricing section
  featuredOrder    Int             @default(0)     // Order among featured products (1: primary with blue border and center, 2, 3)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  orders          Order[]
  plans           Plan[]
  variants        ProductVariant[]
  inventoryItems  InventoryItem[]
  coupons         Coupon[]
  reviews         Review[]

  @@index([isFeatured, featuredOrder])
  @@map("products")
}

model ProductVariant {
  id               String   @id @default(cuid())
  productId        String
  name             String                    // نام نوع: "پرو", "پلاس", "دانشجویی", "اولترا"
  slug             String?                   // اسلاگ اختیاری برای URL
  description      String?                   // توضیح کوتاه درباره این نوع
  price            Int                       // قیمت اصلی به تومان
  discountedPrice  Int?                      // قیمت تخفیف‌خورده (اگر null یعنی تخفیف ندارد)
  discountLabel    String?                   // برچسب تخفیف: "۳۰٪ تخفیف", "ویژه نوروز"
  duration         Int          @default(1)  // مدت زمان بر حسب ماه
  features         Json?                     // آرایه‌ای از ویژگی‌های اختصاصی این نوع
  badge            String?                   // بج نمایشی: "پرفروش", "پیشنهاد ویژه"
  active           Boolean      @default(true)
  sortOrder        Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  plans            Plan[]       // هر Variant می‌تواند چندین Plan داشته باشد
  orders           Order[]
  inventoryItems   InventoryItem[]

  @@index([productId])
  @@index([productId, active])
  @@map("product_variants")
}

model Plan {
  id                String          @id @default(cuid())
  productId         String
  variantId         String?
  name              String
  duration          Int             // duration in months
  planType          String?         // Plan tier/type: Pro, Plus, Student, etc.
  price             Int             // price in Toman (Rials / 10)
  active            Boolean         @default(true)
  fulfillmentType   FulfillmentType @default(ACTIVATION_LINK)
  checkoutFields    Json?           // Array of CheckoutFieldDefinition [{ key, label, type, required, placeholder, order }]
  fulfillmentConfig Json?           // Custom config for fulfillment
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  orders          Order[]
  inventoryItems  InventoryItem[]

  @@index([productId])
  @@index([productId, active])
  @@index([variantId])
  @@map("plans")
}

// =====================
// Order
// =====================
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Coupon {
  id                String       @id @default(cuid())
  code              String       @unique
  description       String?
  discountType      DiscountType @default(PERCENTAGE)
  discountValue     Int          // percentage (e.g. 20 for 20%) or fixed Toman (e.g. 50000)
  minOrderAmount    Int?         // minimum order amount in Toman required to apply
  maxDiscountAmount Int?         // maximum discount amount in Toman for percentage coupons
  maxUses           Int?         // maximum total times coupon can be used across system
  maxUsesPerUser    Int?         @default(1) // maximum uses per user
  usedCount         Int          @default(0)
  expiresAt         DateTime?    // expiration date
  active            Boolean      @default(true)
  productId         String?      // optional: limit to specific product
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  orders            Order[]
  product           Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([code])
  @@index([productId])
  @@map("coupons")
}

model Order {
  id                String            @id @default(cuid())
  userId            String
  productId         String?
  planId            String?
  variantId         String?
  couponId          String?
  amount            Int               // in Toman (final payable amount after discount)
  discountAmount    Int               @default(0) // total discount amount in Toman
  status            OrderStatus       @default(PENDING_PAYMENT)
  fulfillmentStatus FulfillmentStatus @default(PENDING)
  checkoutData      Json?             // Snapshot of customer answers at checkout
  source            String?           @default("web") // "web" | "telegram" | "bale" | "rubika" | "soroush"
  telegramChatId    String?

  // Refund metadata (Section 4.1)
  refundAmount      Int?              // Refunded amount in Toman
  refundReason      String?           // Reason for refund
  refundRefId       String?           // Bank / Sheba tracking reference ID
  refundedAt        DateTime?         // Timestamp of refund

  // Admin Review / Provisioning & Customer Action
  adminNote              String?           // Message / feedback / note from admin to customer
  customerActionRequired Boolean           @default(false) // True when user needs to fix credentials
  actionRequiredReason   String?           // WRONG_PASSWORD | TWO_FACTOR_REQUIRED | INVALID_ACCOUNT | CUSTOM
  credentialsUpdatedAt   DateTime?         // Timestamp when customer updated credentials

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  product         Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  plan            Plan?           @relation(fields: [planId], references: [id], onDelete: SetNull)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  coupon          Coupon?         @relation(fields: [couponId], references: [id], onDelete: SetNull)
  payment         Payment?
  delivery        Delivery?
  inventoryItem   InventoryItem?
  supportTickets  SupportTicket[]

  @@index([userId])
  @@index([productId])
  @@index([planId])
  @@index([variantId])
  @@index([couponId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

// =====================
// Payment
// =====================
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String        @unique
  amount          Int
  status          PaymentStatus @default(PENDING)
  gatewayName     String        @default("zarinpal")
  authority       String?       @unique  // Zarinpal authority or Mock transaction ID
  refId           String?       // Zarinpal refId or Mock refId after success
  gatewayResponse Json?
  paidAt          DateTime?     // Exact timestamp when payment was verified
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([refId])
  @@index([gatewayName, status])
  @@map("payments")
}

// =====================
// Item / Link Status
// =====================
enum LinkStatus {
  AVAILABLE
  RESERVED
  USED
  INVALID
}

// =====================
// Support Tickets
// =====================
enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model SupportTicket {
  id          String       @id @default(cuid())
  userId      String?
  orderId     String?
  subject     String
  message     String
  status      TicketStatus @default(OPEN)
  contactInfo String?      // phone / telegram / email
  response    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@map("support_tickets")
}

// =====================
// System Settings
// =====================
model SystemSetting {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

// =====================
// Generic Deliveries
// =====================
model Delivery {
  id          String          @id @default(cuid())
  orderId     String          @unique
  type        FulfillmentType
  status      DeliveryStatus  @default(DELIVERED)
  data        Json            // { link?: string, email?: string, password?: string, manualNote?: string, ... }
  deliveredAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("deliveries")
}

// =====================
// Generic Inventory Items (Links, Accounts, etc.)
// =====================
model InventoryItem {
  id         String        @id @default(cuid())
  productId  String?
  planId     String?
  variantId  String?
  type       InventoryType
  status     LinkStatus    @default(AVAILABLE) // AVAILABLE, RESERVED, USED, INVALID
  data       Json          // { url?: string } or { email?: string, password?: string, note?: string }
  orderId    String?       @unique
  assignedAt DateTime?
  usedAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  product    Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  plan       Plan?           @relation(fields: [planId], references: [id], onDelete: SetNull)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  order      Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, planId, status])
  @@index([planId, status])
  @@index([productId, status])
  @@index([variantId, status])
  @@index([type, status])
  @@index([type, status, planId])
  @@index([type, status, productId])
  @@index([type, status, variantId])
  @@index([productId, variantId, planId, status])
  @@map("inventory_items")
}

// =====================
// Notifications
// =====================
enum NotificationType {
  ORDER_SUCCESS
  ORDER_FAILED
  ORDER_READY
  ORDER_PENDING_DELIVERY
  ORDER_ACTION_REQUIRED
  SUPPORT_REPLY
  SYSTEM_ANNOUNCEMENT
  PROMOTION
}

model Notification {
  id        String           @id @default(cuid())
  userId    String?          // null = broadcast to all users
  title     String
  message   String
  type      NotificationType @default(SYSTEM_ANNOUNCEMENT)
  link      String?          // optional link/action
  metadata  Json?            // optional { orderId, ticketId, etc. }
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reads     NotificationRead[]

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationRead {
  id             String       @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime     @default(now())

  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
  @@map("notification_reads")
}

// =====================
// Telegram Bot Session
// =====================
model BotSession {
  id         String   @id @default(cuid())
  telegramId String   @unique
  data       Json
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([telegramId])
  @@index([expiresAt])
  @@map("bot_sessions")
}

// =====================
// Product Reviews / Comments
// =====================
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id         String       @id @default(cuid())
  productId  String
  userId     String?
  userName   String
  rating     Int          @default(5)
  comment    String
  status     ReviewStatus @default(PENDING)
  isFeatured Boolean      @default(false)
  adminNote  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@index([status, createdAt])
  @@index([isFeatured, status])
  @@index([productId])
  @@index([userId])
  @@map("reviews")
}



