# ==========================================
# App
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# Database (PostgreSQL)
# ==========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5532/google_ai_pro

# ==========================================
# Auth (JWT) & Security
# ==========================================
JWT_SECRET=change-this-to-a-very-long-random-secret-string-at-least-32-chars
CREDENTIALS_ENCRYPTION_KEY=change-this-to-a-dedicated-32-chars-key-or-leave-empty-to-use-jwt-secret

# ==========================================
# کاوه‌نگار SMS (برای OTP)
# ==========================================
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# ==========================================
# Zarinpal Payment Gateway
# ==========================================
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
NEXT_PUBLIC_ZARINPAL_CALLBACK_URL=http://localhost:3000/api/payment/callback

# ==========================================
# Support contact info
# ==========================================
NEXT_PUBLIC_SUPPORT_PHONE=021-XXXXXXXX
NEXT_PUBLIC_SUPPORT_TELEGRAM=https://t.me/your_support_username

# ==========================================
# Telegram Bot
# ==========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=my_telegram_webhook_secret_key