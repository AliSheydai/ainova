# ==========================================
# App
# ==========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# Database (PostgreSQL)
# ==========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5532/google_ai_pro

# ==========================================
# Auth (JWT) & Security
# ==========================================
# Generate a cryptographically secure 64-char hex string: openssl rand -hex 32
JWT_SECRET=change-this-to-a-very-long-random-secret-string-at-least-32-chars

# IMPORTANT: Dedicated AES-256-GCM encryption key for customer credentials.
# Must be generated separately from JWT_SECRET using: openssl rand -hex 32
# If not set in production, system logs a security warning and falls back to JWT_SECRET.
# Warning: If you rely on fallback and rotate JWT_SECRET later, previously encrypted database
# credentials (e.g. Gmail passwords) will become permanently unrecoverable!
CREDENTIALS_ENCRYPTION_KEY=change-this-to-a-dedicated-32-chars-key-for-database-encryption
# Optional fallback key during rotation migrations:
# CREDENTIALS_ENCRYPTION_FALLBACK_KEY=

# ==========================================
# کاوه‌نگار SMS (برای OTP)
# ==========================================
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# ==========================================
# Payment Gateway Provider ("mock" | "zarinpal" | "zibal" | "jibit")
# ==========================================
# In Development/Testing:
# PAYMENT_PROVIDER=zibal
# ZIBAL_SANDBOX=true
# ZIBAL_MERCHANT=zibal
# ALLOW_MOCK_PAYMENT=true
#
# In Production:
# PAYMENT_PROVIDER=zibal
# ZIBAL_SANDBOX=false
# ZIBAL_MERCHANT=your-zibal-merchant-key
PAYMENT_PROVIDER=zibal
ALLOW_MOCK_PAYMENT=true

# ==========================================
# Zibal Payment Gateway (IPG)
# ==========================================
# For test/sandbox: use "zibal" as merchant code
ZIBAL_MERCHANT=zibal
ZIBAL_SANDBOX=true
ZIBAL_BASE_URL=https://gateway.zibal.ir

# ==========================================
# Jibit Payment Gateway (PPG v3)
# ==========================================
JIBIT_API_KEY=
JIBIT_SECRET_KEY=
JIBIT_SANDBOX=true
JIBIT_BASE_URL=https://napi.jibit.ir

# ==========================================
# Zarinpal Payment Gateway
# ==========================================
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
NEXT_PUBLIC_ZARINPAL_CALLBACK_URL=http://localhost:3000/api/payment/callback

# ==========================================
# Support contact info
# ==========================================
NEXT_PUBLIC_SUPPORT_PHONE=021-XXXXXXXX
NEXT_PUBLIC_SUPPORT_TELEGRAM=https://t.me/your_support_username

# ==========================================
# Telegram Bot
# ==========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=my_telegram_webhook_secret_key

# ==========================================
# Scheduled Cron Jobs
# ==========================================
# REQUIRED IN PRODUCTION:
# Must be generated with: openssl rand -hex 32
# Scheduled endpoints (/api/cron/expire-orders and /api/cron/otp/cleanup) strictly require authentication via:
#   Header: Authorization: Bearer <CRON_SECRET>
#   or Header: x-cron-secret: <CRON_SECRET>
# Requests passing secret via URL query parameter (?secret=...) are rejected in production to prevent leakage in logs.
CRON_SECRET=change-this-to-a-secure-random-secret-for-cron-jobs